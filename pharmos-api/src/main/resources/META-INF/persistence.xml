<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">

            <persistence-unit name="com.pharmos.common" transaction-type="RESOURCE_LOCAL">
                <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

                <class>com.pharmos.customer.domain.Customer</class>
                <class>com.pharmos.address.domain.Address</class>
                <class>com.pharmos.category.domain.Category</class>
                <class>com.pharmos.product.domain.Product</class>
                <exclude-unlisted-classes>true</exclude-unlisted-classes>

                <properties>
                    <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/pharmos"/>
                    <property name="jakarta.persistence.jdbc.user" value="pharmos"/>
                    <property name="jakarta.persistence.jdbc.password" value="pharmos"/>
                    <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>

                    <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
                    <property name="hibernate.hbm2ddl.auto" value="none"/>
                    <property name="hibernate.show_sql" value="true" />
                    <property name="hibernate.format_sql" value="true"/>
                </properties>
            </persistence-unit>
</persistence>